{
  "manifest_version": 3,
  "name": "智能营销管理系统·企微渠道采集器",
  "version": "0.2.4",
  "description": "定时捕获企微智能表格导出文件并同步到CRM渠道来源。",
  "permissions": [
    "activeTab",
    "alarms",
    "downloads",
    "notifications",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://doc.weixin.qq.com/*",
    "https://drive.weixin.qq.com/*",
    "https://docs.qq.com/*",
    "https://*.qpic.cn/*",
    "https://*.gtimg.com/*",
    "https://*.tencent.com/*",
    "https://*.myqcloud.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "企微渠道采集器",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://doc.weixin.qq.com/smartsheet/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://doc.weixin.qq.com/smartsheet/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
