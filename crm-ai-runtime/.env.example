# ============================================================
# Python AI运行时本地开发环境变量模板
# 使用方法：复制为 .env 后再启动Uvicorn或PyCharm调试
# ============================================================

# -------------------- Web服务 --------------------
# FastAPI监听地址；0.0.0.0表示允许其他主机访问
CRM_AI_HOST=0.0.0.0
# FastAPI监听端口
CRM_AI_PORT=8001
# Java服务调用Python运行时的内部鉴权令牌，本地联调时两端必须一致
CRM_AI_INTERNAL_TOKEN=
# CRM登录JWT密钥，必须和Nacos中crm.jwt.secret保持一致
CRM_AI_JWT_SECRET=
# Python服务日志级别，可选DEBUG、INFO、WARNING、ERROR
CRM_AI_LOG_LEVEL=INFO

# -------------------- 大模型调用 --------------------
# Python调用大模型的超时时间，单位秒
CRM_AI_LLM_TIMEOUT_SECONDS=60
# 流式调用时是否要求模型返回usage；部分兼容接口不支持时可改为false
CRM_AI_LLM_STREAM_INCLUDE_USAGE=true

# -------------------- CRM业务工具 --------------------
# Python智能体访问Gateway的地址；本地联调通常为http://localhost:8090
CRM_AI_CRM_API_BASE_URL=http://localhost:8090
# CRM业务工具请求超时时间，单位秒
CRM_AI_CRM_API_TIMEOUT_SECONDS=30
# 已挂载MCP不可访问时是否终止本次智能体运行，生产环境建议保持true
CRM_AI_MCP_FAIL_FAST=true

# -------------------- 联网搜索 --------------------
# 是否启用企业公开信息联网搜索
CRM_AI_WEB_SEARCH_ENABLED=false
# 搜索提供方，目前支持searxng
CRM_AI_WEB_SEARCH_PROVIDER=searxng
# 搜索服务地址，例如http://192.168.1.10:8888
CRM_AI_WEB_SEARCH_ENDPOINT=
# 搜索服务密钥；服务不需要鉴权时保持为空
CRM_AI_WEB_SEARCH_API_KEY=
# 搜索请求超时时间，单位秒
CRM_AI_WEB_SEARCH_TIMEOUT_SECONDS=8
# 单次搜索最多返回结果数
CRM_AI_WEB_SEARCH_MAX_RESULTS=5

# -------------------- LangGraph Checkpoint --------------------
# 是否持久化LangGraph运行状态
CRM_AI_CHECKPOINT_ENABLED=true
# Checkpoint后端，可选memory或postgres
CRM_AI_CHECKPOINT_BACKEND=memory
# PostgreSQL连接串；选择postgres后端时必填
# 示例：postgresql://app_user:password@localhost:5432/crm
CRM_AI_CHECKPOINT_POSTGRES_URI=
# Checkpoint连接池最小连接数
CRM_AI_CHECKPOINT_POOL_MIN_SIZE=1
# Checkpoint连接池最大连接数
CRM_AI_CHECKPOINT_POOL_MAX_SIZE=10
# Checkpoint连接池等待超时，单位秒
CRM_AI_CHECKPOINT_POOL_TIMEOUT_SECONDS=30
# Trace是否记录完整输入输出；涉及客户数据时建议关闭
CRM_AI_TRACE_CAPTURE_PAYLOAD=false

# -------------------- LangSmith链路追踪 --------------------
# 是否启用LangSmith Trace
LANGSMITH_TRACING=false
# LangSmith访问密钥
LANGSMITH_API_KEY=
# LangSmith项目名称
LANGSMITH_PROJECT=crm-ai-runtime-dev
# LangSmith服务地址
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 是否隐藏Trace输入内容
LANGSMITH_HIDE_INPUTS=false
# 是否隐藏Trace输出内容
LANGSMITH_HIDE_OUTPUTS=false
# 是否启用LangGraph严格消息序列化
LANGGRAPH_STRICT_MSGPACK=true

# -------------------- CRM数据库读取 --------------------
# 是否允许Python运行时读取CRM数据库
CRM_AI_DATABASE_ENABLED=true
# PostgreSQL连接地址，示例：postgresql://app_user:password@localhost:5432/crm
CRM_AI_DATABASE_URI=
# 智能体配置来源：request表示Java请求传入，database表示Python按场景从agents表读取
CRM_AI_AGENT_CONFIG_SOURCE=database
# 数据库配置读取失败时是否直接失败，生产环境必须保持true，避免回退到过期配置
CRM_AI_AGENT_CONFIG_FAIL_FAST=true
# 默认每日Token额度，0表示不限制
CRM_AI_TOKEN_DAILY_LIMIT=0
# 每次运行预留输出Token额度
CRM_AI_TOKEN_RESERVE_OUTPUT_TOKENS=4000

# -------------------- 智能体报告生成 --------------------
# 是否允许智能体生成Word、PDF和HTML报告
CRM_AI_REPORT_ENABLED=true
# 单份报告允许的最大Markdown字符数
CRM_AI_REPORT_MAX_CONTENT_CHARS=100000
# 本地开发未连接MinIO时的报告存储目录
CRM_AI_REPORT_LOCAL_DIR=./data/reports
# 是否将生成报告存入MinIO；本地调试可设为false
CRM_AI_REPORT_MINIO_ENABLED=false
# MinIO服务地址；Docker环境通常为http://crm-minio:9000
CRM_AI_REPORT_MINIO_ENDPOINT=http://localhost:9000
# MinIO访问账号
CRM_AI_REPORT_MINIO_ACCESS_KEY=
# MinIO访问密码
CRM_AI_REPORT_MINIO_SECRET_KEY=
# 报告文件使用的MinIO存储桶
CRM_AI_REPORT_MINIO_BUCKET=crm

# -------------------- Nacos注册中心 --------------------
# 是否向Nacos注册Python AI运行时
CRM_AI_NACOS_ENABLED=false
# Nacos服务地址
CRM_AI_NACOS_SERVER_ADDR=localhost:8848
# Nacos命名空间
CRM_AI_NACOS_NAMESPACE=
# Nacos分组
CRM_AI_NACOS_GROUP=DEFAULT_GROUP
# Nacos用户名
CRM_AI_NACOS_USERNAME=
# Nacos密码
CRM_AI_NACOS_PASSWORD=
# 注册到Nacos的服务名
CRM_AI_NACOS_SERVICE_NAME=crm-ai-runtime
# 注册IP，容器环境建议明确指定，留空则自动获取
CRM_AI_NACOS_IP=
# 注册端口
CRM_AI_NACOS_PORT=8001
# Nacos集群名
CRM_AI_NACOS_CLUSTER_NAME=DEFAULT
# 是否注册临时实例
CRM_AI_NACOS_EPHEMERAL=true
# 心跳间隔，单位秒
CRM_AI_NACOS_HEARTBEAT_SECONDS=5
