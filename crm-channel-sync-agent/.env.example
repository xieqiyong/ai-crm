# noVNC访问密码，仅用于首次扫码登录企微
VNC_PASSWORD=请替换为强密码

# noVNC监听地址和端口；仅在受信任内网直接访问时将地址改为0.0.0.0
NOVNC_BIND_ADDRESS=127.0.0.1
NOVNC_PORT=6081

# CRM渠道同步内部令牌，必须与Nacos中的crm.channel.sync.internal-token一致
CRM_CHANNEL_SYNC_INTERNAL_TOKEN=

# 是否启用CRM上传
CRM_API_ENABLED=true

# CRM入口地址，容器访问宿主机可使用host.docker.internal
CRM_API_BASE_URL=http://host.docker.internal:8088

# CRM内部渠道导入接口
CRM_API_IMPORT_PATH=/api/internal/channel/source/import-excel

# CRM接口超时时间，单位毫秒
CRM_API_TIMEOUT_MS=120000
