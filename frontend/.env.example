# ============================================================
# 前端环境变量模板
# 使用方法：按部署环境复制或合并到对应的 .env 文件
# 注意事项：VITE_ 开头的变量会暴露给浏览器，禁止填写任何密钥
# ============================================================

# 当前前端环境标识
VITE_APP_ENV=development

# 后台接口基础地址；开发代理或同域部署时保持为空
VITE_API_BASE_URL=

# 普通接口超时时间，单位毫秒
VITE_API_TIMEOUT=30000

# AI 回答打字机刷新间隔，单位毫秒；越小显示越快
VITE_ASSISTANT_TYPEWRITER_INTERVAL=12

# AI 回答每次追加的字符数量；越大显示越快
VITE_ASSISTANT_TYPEWRITER_STEP=4

# Vite 开发服务器代理地址；本地开发必须代理到 Gateway
VITE_DEV_PROXY_TARGET=http://localhost:8090
