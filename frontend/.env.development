# 开发环境标识
VITE_APP_ENV=development

# 开发环境默认通过 Vite 代理访问后台，因此保持为空
VITE_API_BASE_URL=

# 普通接口超时时间，单位毫秒
VITE_API_TIMEOUT=30000

# AI 回答打字机刷新间隔，单位毫秒
VITE_ASSISTANT_TYPEWRITER_INTERVAL=12

# AI 回答每次追加的字符数量
VITE_ASSISTANT_TYPEWRITER_STEP=4

# 本地开发必须走 Gateway，不能直接连 crm-web
VITE_DEV_PROXY_TARGET=http://localhost:8090
