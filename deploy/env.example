# ============================================================
# 智能营销管理系统离线部署环境变量模板
# 使用方法：复制为 .env 后按实际环境修改
# 注意事项：所有 please-change 开头的值在生产环境必须替换
# ============================================================

# -------------------- 发布与基础设置 --------------------
# 镜像版本号，必须与离线包内镜像标签保持一致
CRM_VERSION=latest
# Docker Compose 项目名称，用于隔离容器、网络和数据卷
COMPOSE_PROJECT_NAME=crm
# 容器时区
CRM_TIMEZONE=Asia/Shanghai

# -------------------- 前端访问设置 --------------------
# 前端对外暴露端口
CRM_FRONTEND_PORT=80
# 浏览器请求后台的基础地址；同域反向代理时保持为空
CRM_FRONTEND_API_BASE_URL=
# 前端普通接口超时时间，单位毫秒
CRM_FRONTEND_API_TIMEOUT=30000
# AI回答打字机刷新间隔，单位毫秒；越小显示越快
CRM_ASSISTANT_TYPEWRITER_INTERVAL=12
# AI回答每次追加的字符数量；越大显示越快
CRM_ASSISTANT_TYPEWRITER_STEP=4

# -------------------- PostgreSQL 数据库 --------------------
# PostgreSQL数据库名称
CRM_DB_NAME=crm
# PostgreSQL业务账号
CRM_DB_USERNAME=app_user
# PostgreSQL业务密码，生产环境必须修改
CRM_DB_PASSWORD=please-change-db-password
# JPA仅用于DDL初始化和演进；首装可用update，严格生产环境建议迁移完成后改为validate
CRM_JPA_DDL_AUTO=update

# -------------------- Druid 连接池 --------------------
# 启动时初始化连接数
CRM_DRUID_INITIAL_SIZE=1
# 最小空闲连接数
CRM_DRUID_MIN_IDLE=1
# 最大活动连接数
CRM_DRUID_MAX_ACTIVE=20
# 获取连接最大等待时间，单位毫秒
CRM_DRUID_MAX_WAIT=60000
# 空闲连接检测间隔，单位毫秒
CRM_DRUID_EVICTION_INTERVAL=60000
# 连接最小空闲时间，单位毫秒
CRM_DRUID_MIN_EVICTABLE_IDLE_TIME=300000
# 数据库连接有效性检测SQL
CRM_DRUID_VALIDATION_QUERY=select 1

# -------------------- Redis 会话与缓存 --------------------
# 是否启用Redis
CRM_REDIS_ENABLED=true
# Redis密码，生产环境必须修改
CRM_REDIS_PASSWORD=please-change-redis-password
# Redis逻辑库编号
CRM_REDIS_DATABASE=1

# -------------------- Java 服务与认证 --------------------
# JVM启动参数，请根据服务器内存调整
CRM_JAVA_OPTS=-Xms512m -Xmx1024m -Dfile.encoding=UTF-8
# 单文件上传上限
CRM_UPLOAD_MAX_FILE_SIZE=10MB
# 单次请求上传总大小上限
CRM_UPLOAD_MAX_REQUEST_SIZE=12MB
# JWT签名密钥，生产环境必须使用至少32字节的随机值
CRM_JWT_SECRET=please-change-this-secret-key-to-at-least-32-bytes
# 登录有效期，单位秒；86400表示1天
CRM_JWT_TTL_SECONDS=86400
# 忘记密码令牌有效期，单位秒
CRM_PASSWORD_RESET_TTL_SECONDS=900
# 是否在接口响应中直接返回重置令牌；生产环境必须为false
CRM_PASSWORD_RESET_EXPOSE_TOKEN=false

# -------------------- 日志与本地文件 --------------------
# 后台日志级别，可选TRACE、DEBUG、INFO、WARN、ERROR
CRM_LOG_LEVEL=INFO
# 日志保留天数
CRM_LOG_MAX_HISTORY=30
# 单个日志文件最大大小
CRM_LOG_MAX_FILE_SIZE=100MB
# 渠道资料在容器内的保存目录，建议保持默认
CRM_CHANNEL_UPLOAD_DIR=/app/uploads/channel
# 通用附件在容器内的保存目录，建议保持默认
CRM_STORAGE_UPLOAD_DIR=/app/uploads
# 本地附件对外访问路径
CRM_STORAGE_PUBLIC_PATH=/uploads

# -------------------- 企业微信客户同步 --------------------
# 企业微信接口地址，通常无需修改
CRM_WECOM_BASE_URL=https://qyapi.weixin.qq.com
# 企业微信接口连接超时，单位毫秒
CRM_WECOM_CONNECT_TIMEOUT_MS=5000
# 企业微信接口读取超时，单位毫秒
CRM_WECOM_READ_TIMEOUT_MS=30000
# 定时任务扫描间隔，单位毫秒；每个企业实际同步频率在渠道页面配置
CRM_WECOM_SCHEDULE_DELAY_MS=60000
# 服务启动后首次扫描延迟，单位毫秒
CRM_WECOM_SCHEDULE_INITIAL_DELAY_MS=30000
# 是否补充读取企业微信客户详情，用于获取完整跟进人、标签和对外资料
CRM_WECOM_FETCH_DETAIL_ENABLED=true
# 是否读取企业微信客户标签库，用于把标签ID转换成标签名称
CRM_WECOM_FETCH_TAGS_ENABLED=true

# -------------------- Java Agent联网搜索 --------------------
# 是否启用Java Agent企业公开信息搜索
CRM_AGENT_WEB_SEARCH_ENABLED=false
# 搜索提供方，目前支持searxng
CRM_AGENT_WEB_SEARCH_PROVIDER=searxng
# 搜索服务地址，例如http://192.168.1.10:8888
CRM_AGENT_WEB_SEARCH_ENDPOINT=
# 搜索服务密钥；服务不需要鉴权时保持为空
CRM_AGENT_WEB_SEARCH_API_KEY=
# 搜索请求超时时间，单位毫秒
CRM_AGENT_WEB_SEARCH_TIMEOUT_MS=8000
# 单次搜索最多返回结果数
CRM_AGENT_WEB_SEARCH_MAX_RESULTS=5
# 是否抓取搜索结果详情页
CRM_AGENT_WEB_SEARCH_FETCH_DETAIL=true
# 单次最多抓取的详情页数量
CRM_AGENT_WEB_SEARCH_DETAIL_LIMIT=3

# -------------------- Agent Token额度 --------------------
# 未单独分配额度时的用户每日默认Token上限
CRM_AGENT_TOKEN_DAILY_LIMIT=100000
# 调用前为模型输出预留的Token数量
CRM_AGENT_TOKEN_RESERVE_OUTPUT_TOKENS=2048

# -------------------- Java与Python AI运行时通信 --------------------
# Java服务和Python AI运行时之间的内部鉴权令牌，生产环境必须修改且两端一致
CRM_AI_INTERNAL_TOKEN=please-change-ai-internal-token
# Java调用Python AI运行时的超时时间，单位毫秒
CRM_AI_RUNTIME_TIMEOUT_MS=90000

# -------------------- Python AI运行时 --------------------
# Python AI运行时日志级别
CRM_AI_LOG_LEVEL=INFO
# Python调用大模型的超时时间，单位秒
CRM_AI_LLM_TIMEOUT_SECONDS=60
# 是否启用Python联网搜索
CRM_AI_WEB_SEARCH_ENABLED=false
# Python联网搜索提供方，目前支持searxng
CRM_AI_WEB_SEARCH_PROVIDER=searxng
# Python联网搜索服务地址
CRM_AI_WEB_SEARCH_ENDPOINT=
# Python联网搜索服务密钥
CRM_AI_WEB_SEARCH_API_KEY=
# Python联网搜索超时时间，单位秒
CRM_AI_WEB_SEARCH_TIMEOUT_SECONDS=8
# Python单次搜索最多返回结果数
CRM_AI_WEB_SEARCH_MAX_RESULTS=5

# -------------------- LangGraph Checkpoint --------------------
# 是否持久化LangGraph运行状态
CRM_AI_CHECKPOINT_ENABLED=false
# Checkpoint后端，可选memory或postgres
CRM_AI_CHECKPOINT_BACKEND=memory
# PostgreSQL连接串；使用postgres后端时必填
CRM_AI_CHECKPOINT_POSTGRES_URI=
# 是否自动初始化Checkpoint表
CRM_AI_CHECKPOINT_AUTO_SETUP=true
# Trace是否采集输入输出正文；生产环境建议关闭，避免敏感数据进入日志
CRM_AI_TRACE_CAPTURE_PAYLOAD=false

# -------------------- LangSmith链路追踪 --------------------
# 是否启用LangSmith Trace
LANGSMITH_TRACING=false
# LangSmith访问密钥
LANGSMITH_API_KEY=
# LangSmith项目名称
LANGSMITH_PROJECT=crm-ai-runtime
# LangSmith服务地址
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 是否隐藏Trace输入内容
LANGSMITH_HIDE_INPUTS=false
# 是否隐藏Trace输出内容
LANGSMITH_HIDE_OUTPUTS=false
# 是否启用LangGraph严格消息序列化
LANGGRAPH_STRICT_MSGPACK=true

# -------------------- Nacos配置中心 --------------------
# 是否启用Nacos；当前未启用时以下配置不会生效
CRM_NACOS_ENABLED=false
# Nacos服务地址
CRM_NACOS_SERVER_ADDR=localhost:8848
# Nacos命名空间，默认公共命名空间时保持为空
CRM_NACOS_NAMESPACE=
# Nacos配置分组
CRM_NACOS_GROUP=DEFAULT_GROUP

# -------------------- MinIO对象存储 --------------------
# 是否启用MinIO附件存储
CRM_MINIO_ENABLED=false
# MinIO服务端地址；使用离线包内MinIO时保持默认
CRM_MINIO_ENDPOINT=http://crm-minio:9000
# MinIO文件公开访问地址；通过前端代理时可使用/minio
CRM_MINIO_PUBLIC_URL=/minio
# MinIO访问账号
CRM_MINIO_ACCESS_KEY=minioadmin
# MinIO访问密钥，生产环境必须修改
CRM_MINIO_SECRET_KEY=please-change-minio-secret
# 附件存储桶名称
CRM_MINIO_BUCKET=crm
# 是否允许存储桶公开读取；敏感附件场景建议关闭并使用签名地址
CRM_MINIO_PUBLIC_READ=true

# -------------------- Elasticsearch --------------------
# 是否启用Elasticsearch
CRM_ES_ENABLED=true
# Elasticsearch地址，离线包不内置ES；宿主机服务可使用host.docker.internal
CRM_ES_URIS=http://host.docker.internal:9200
# Elasticsearch账号；未启用鉴权时保持为空
CRM_ES_USERNAME=
# Elasticsearch密码；未启用鉴权时保持为空
CRM_ES_PASSWORD=

# -------------------- Kafka --------------------
# Kafka地址，多个节点使用英文逗号分隔
CRM_KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092

# -------------------- 知识库异步入库 --------------------
# 文档入库线程池核心线程数
CRM_KB_INGEST_CORE_SIZE=2
# 文档入库线程池最大线程数
CRM_KB_INGEST_MAX_SIZE=4
# 文档入库等待队列长度
CRM_KB_INGEST_QUEUE_CAPACITY=100
# 超过该分钟数仍未结束的任务视为遗留任务
CRM_KB_INGEST_STALE_TASK_MINUTES=120

# -------------------- 知识库混合检索 --------------------
# Milvus向量召回候选数量
CRM_KB_SEARCH_VECTOR_CANDIDATES=20
# Elasticsearch关键词召回候选数量
CRM_KB_SEARCH_KEYWORD_CANDIDATES=20
# PostgreSQL降级召回候选数量
CRM_KB_SEARCH_DATABASE_CANDIDATES=20
# 向量召回RRF权重，范围0到1
CRM_KB_SEARCH_VECTOR_WEIGHT=0.55
# 关键词召回RRF权重，范围0到1
CRM_KB_SEARCH_KEYWORD_WEIGHT=0.35
# 数据库降级召回RRF权重，范围0到1
CRM_KB_SEARCH_DATABASE_WEIGHT=0.10
# RRF平滑常数，通常保持60
CRM_KB_SEARCH_RRF_K=60
# 归一化融合分最低阈值，0表示不过滤
CRM_KB_SEARCH_MIN_SCORE=0
# true表示PG仅在Milvus和ES都无结果时参与降级
CRM_KB_SEARCH_DATABASE_FALLBACK_ONLY=true

# -------------------- 文档切分与Embedding --------------------
# 单个知识分片最大字符数
CRM_KB_CHUNK_MAX_CHARS=900
# 相邻知识分片重叠字符数
CRM_KB_CHUNK_OVERLAP_CHARS=120
# 是否生成向量并写入Milvus
CRM_KB_EMBEDDING_ENABLED=true
# OpenAI兼容Embedding接口地址；宿主机Ollama使用host.docker.internal
CRM_KB_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# Embedding接口密钥；Ollama通常保持为空
CRM_KB_EMBEDDING_API_KEY=
# Embedding模型名称
CRM_KB_EMBEDDING_MODEL=bge-m3:latest
# 向量维度；0表示读取模型返回维度
CRM_KB_EMBEDDING_DIMENSIONS=0
# Embedding请求超时时间，单位毫秒
CRM_KB_EMBEDDING_TIMEOUT_MS=30000

# -------------------- 知识库Elasticsearch索引 --------------------
# 知识分片基础索引名称，蓝绿重建会在此基础上生成代次索引
CRM_KB_ES_INDEX=crm_knowledge_chunk
# 知识库ES请求超时时间，单位毫秒
CRM_KB_ES_TIMEOUT_MS=10000

# -------------------- 知识库Milvus索引 --------------------
# 是否启用Milvus向量库
CRM_KB_MILVUS_ENABLED=true
# Milvus服务地址，离线包不内置Milvus；宿主机服务可使用host.docker.internal
CRM_KB_MILVUS_ENDPOINT=http://host.docker.internal:19530
# Milvus鉴权令牌；未启用鉴权时保持为空
CRM_KB_MILVUS_TOKEN=
# Milvus数据库名称；使用default时保持为空
CRM_KB_MILVUS_DATABASE=
# 知识分片基础集合名称，蓝绿重建会在此基础上生成代次集合
CRM_KB_MILVUS_COLLECTION=crm_knowledge_chunk
# Milvus请求超时时间，单位毫秒
CRM_KB_MILVUS_TIMEOUT_MS=10000

# -------------------- 知识库变更补偿与Kafka --------------------
# Outbox变更补偿扫描间隔，单位毫秒
CRM_KB_CHANGE_RECONCILE_DELAY_MS=3000
# 应用启动后首次补偿扫描延迟，单位毫秒
CRM_KB_CHANGE_RECONCILE_INITIAL_DELAY_MS=10000
# 是否通过Kafka发布知识库变更事件
CRM_KB_KAFKA_ENABLED=false
# 知识库变更Topic
CRM_KB_KAFKA_TOPIC=crm-knowledge-change
# 知识库索引消费者组
CRM_KB_KAFKA_GROUP_ID=crm-knowledge-indexer
# Outbox单次发布最大数量
CRM_KB_KAFKA_PUBLISH_BATCH_SIZE=100
# Outbox发布扫描间隔，单位毫秒
CRM_KB_KAFKA_PUBLISH_DELAY_MS=1000
# 应用启动后首次Outbox发布延迟，单位毫秒
CRM_KB_KAFKA_PUBLISH_INITIAL_DELAY_MS=5000
# Kafka消息发送超时时间，单位毫秒
CRM_KB_KAFKA_SEND_TIMEOUT_MS=10000
