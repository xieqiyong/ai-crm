# ============================================================
# 智能营销管理系统 Nacos 模式环境变量
# 业务配置全部放到 Nacos，这里只保留 Docker 和 Nacos 启动必需项
# ============================================================

# -------------------- 发布与容器基础设置 --------------------
CRM_VERSION=latest
COMPOSE_PROJECT_NAME=crm
CRM_TIMEZONE=Asia/Shanghai

# -------------------- 前端访问设置 --------------------
CRM_FRONTEND_PORT=80
CRM_FRONTEND_API_BASE_URL=
CRM_FRONTEND_API_TIMEOUT=30000
CRM_ASSISTANT_TYPEWRITER_INTERVAL=12
CRM_ASSISTANT_TYPEWRITER_STEP=4

# -------------------- 网关与AI运行时 --------------------
CRM_GATEWAY_PORT=8090
CRM_GATEWAY_JAVA_OPTS=-Xms256m -Xmx512m -Dfile.encoding=UTF-8 -Dreactor.netty.http.server.accessLogEnabled=true
CRM_GATEWAY_CONNECT_TIMEOUT_MS=5000
CRM_GATEWAY_RESPONSE_TIMEOUT_MS=300s
CRM_AI_RUNTIME_PORT=8001
CRM_AI_INTERNAL_TOKEN=
CRM_AI_JWT_SECRET=
CRM_AI_DATABASE_ENABLED=true
CRM_AI_DATABASE_URI=
CRM_AI_AGENT_CONFIG_SOURCE=database
CRM_AI_AGENT_CONFIG_FAIL_FAST=false
CRM_AI_TOKEN_DAILY_LIMIT=0
CRM_AI_TOKEN_RESERVE_OUTPUT_TOKENS=4000
CRM_AI_WEB_SEARCH_ENABLED=true
CRM_AI_WEB_SEARCH_PROVIDER=searxng
CRM_AI_WEB_SEARCH_ENDPOINT=
CRM_AI_WEB_SEARCH_API_KEY=
CRM_AI_CHECKPOINT_ENABLED=false
CRM_AI_CHECKPOINT_BACKEND=memory
CRM_AI_CHECKPOINT_POSTGRES_URI=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=crm-ai-runtime

# -------------------- 内置 PostgreSQL 容器设置 --------------------
CRM_DB_NAME=crm
CRM_DB_USERNAME=app_user
CRM_DB_PASSWORD=please-change-db-password

# -------------------- 内置 Redis 容器设置 --------------------
CRM_REDIS_PASSWORD=please-change-redis-password

# -------------------- 内置 MinIO 容器设置 --------------------
CRM_MINIO_ACCESS_KEY=minioadmin
CRM_MINIO_SECRET_KEY=please-change-minio-secret

# -------------------- Java 容器启动参数 --------------------
CRM_JAVA_OPTS=-Xms512m -Xmx1024m -Dfile.encoding=UTF-8
CRM_MCP_JAVA_OPTS=

# -------------------- Nacos 配置中心 --------------------
CRM_NACOS_ENABLED=true
CRM_NACOS_SERVER_ADDR=192.168.50.105:8848
CRM_NACOS_NAMESPACE=
CRM_NACOS_GROUP=DEFAULT_GROUP
CRM_NACOS_DATA_ID=crm.yaml
CRM_MCP_NACOS_DATA_ID=crm-mcp.yaml
CRM_GATEWAY_NACOS_DATA_ID=crm-gateway.yaml
CRM_NACOS_SHARED_DATA_IDS=
CRM_NACOS_USERNAME=
CRM_NACOS_PASSWORD=
CRM_NACOS_TIMEOUT_MS=5000
CRM_NACOS_FAIL_FAST=true
CRM_NACOS_DISCOVERY_ENABLED=true
CRM_NACOS_DISCOVERY_CLUSTER_NAME=DEFAULT
