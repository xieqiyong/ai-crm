CRM_VERSION=latest
COMPOSE_PROJECT_NAME=crm
CRM_TIMEZONE=Asia/Shanghai

CRM_FRONTEND_PORT=80
CRM_FRONTEND_API_BASE_URL=
CRM_FRONTEND_API_TIMEOUT=30000
CRM_ASSISTANT_TYPEWRITER_INTERVAL=12
CRM_ASSISTANT_TYPEWRITER_STEP=4

CRM_DB_NAME=crm
CRM_DB_USERNAME=app_user
CRM_DB_PASSWORD=please-change-db-password
CRM_JPA_DDL_AUTO=update

CRM_REDIS_ENABLED=true
CRM_REDIS_PASSWORD=please-change-redis-password
CRM_REDIS_DATABASE=1

CRM_JAVA_OPTS=-Xms512m -Xmx1024m -Dfile.encoding=UTF-8
CRM_JWT_SECRET=please-change-this-secret-key-to-at-least-32-bytes
CRM_JWT_TTL_SECONDS=86400
CRM_PASSWORD_RESET_EXPOSE_TOKEN=false
CRM_LOG_LEVEL=INFO
CRM_CHANNEL_UPLOAD_DIR=/app/uploads/channel
CRM_STORAGE_UPLOAD_DIR=/app/uploads
CRM_STORAGE_PUBLIC_PATH=/uploads
CRM_AGENT_WEB_SEARCH_ENABLED=false
CRM_AGENT_WEB_SEARCH_PROVIDER=searxng
CRM_AGENT_WEB_SEARCH_ENDPOINT=
CRM_AGENT_WEB_SEARCH_API_KEY=
CRM_AGENT_WEB_SEARCH_TIMEOUT_MS=8000
CRM_AGENT_WEB_SEARCH_MAX_RESULTS=5
CRM_AGENT_WEB_SEARCH_FETCH_DETAIL=true
CRM_AGENT_WEB_SEARCH_DETAIL_LIMIT=3

CRM_AI_INTERNAL_TOKEN=please-change-ai-internal-token
CRM_AI_RUNTIME_TIMEOUT_MS=90000
CRM_AI_LOG_LEVEL=INFO
CRM_AI_WEB_SEARCH_ENABLED=false
CRM_AI_WEB_SEARCH_PROVIDER=searxng
CRM_AI_WEB_SEARCH_ENDPOINT=
CRM_AI_WEB_SEARCH_API_KEY=
CRM_AI_WEB_SEARCH_TIMEOUT_SECONDS=8
CRM_AI_WEB_SEARCH_MAX_RESULTS=5
CRM_AI_CHECKPOINT_ENABLED=false
CRM_AI_CHECKPOINT_BACKEND=memory
CRM_AI_CHECKPOINT_POSTGRES_URI=
CRM_AI_CHECKPOINT_AUTO_SETUP=true
CRM_AI_TRACE_CAPTURE_PAYLOAD=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=crm-ai-runtime
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
LANGGRAPH_STRICT_MSGPACK=true

CRM_NACOS_ENABLED=false
CRM_MINIO_ENABLED=false
CRM_MINIO_ENDPOINT=http://crm-minio:9000
CRM_MINIO_PUBLIC_URL=/minio
CRM_MINIO_ACCESS_KEY=minioadmin
CRM_MINIO_SECRET_KEY=please-change-minio-secret
CRM_MINIO_BUCKET=crm
CRM_MINIO_PUBLIC_READ=true
CRM_ES_ENABLED=true
CRM_ES_URIS=http://crm-elasticsearch:9200
CRM_ES_USERNAME=
CRM_ES_PASSWORD=

CRM_KB_INGEST_CORE_SIZE=2
CRM_KB_INGEST_MAX_SIZE=4
CRM_KB_INGEST_QUEUE_CAPACITY=100
CRM_KB_SEARCH_VECTOR_CANDIDATES=20
CRM_KB_SEARCH_KEYWORD_CANDIDATES=20
CRM_KB_SEARCH_DATABASE_CANDIDATES=20
CRM_KB_SEARCH_VECTOR_WEIGHT=0.55
CRM_KB_SEARCH_KEYWORD_WEIGHT=0.35
CRM_KB_SEARCH_DATABASE_WEIGHT=0.10
CRM_KB_SEARCH_RRF_K=60
CRM_KB_SEARCH_MIN_SCORE=0
CRM_KB_SEARCH_DATABASE_FALLBACK_ONLY=true
CRM_KB_CHUNK_MAX_CHARS=900
CRM_KB_CHUNK_OVERLAP_CHARS=120
CRM_KB_EMBEDDING_ENABLED=true
CRM_KB_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
CRM_KB_EMBEDDING_API_KEY=
CRM_KB_EMBEDDING_MODEL=bge-m3:latest
CRM_KB_EMBEDDING_DIMENSIONS=0
CRM_KB_EMBEDDING_TIMEOUT_MS=30000
CRM_KB_ES_INDEX=crm_knowledge_chunk
CRM_KB_ES_TIMEOUT_MS=10000
CRM_KB_MILVUS_ENABLED=true
CRM_KB_MILVUS_ENDPOINT=http://crm-milvus:19530
CRM_KB_MILVUS_TOKEN=
CRM_KB_MILVUS_DATABASE=
CRM_KB_MILVUS_COLLECTION=crm_knowledge_chunk
CRM_KB_MILVUS_TIMEOUT_MS=10000
