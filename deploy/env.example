# ============================================================
# 智能营销管理系统 Nacos 模式环境变量
# 业务配置全部放到 Nacos，这里只保留 Docker 和 Nacos 启动必需项
# ============================================================

# -------------------- 发布与容器基础设置 --------------------
CRM_VERSION=latest
COMPOSE_PROJECT_NAME=crm
CRM_TIMEZONE=Asia/Shanghai

# -------------------- 前端访问设置 --------------------
CRM_FRONTEND_PORT=80
CRM_FRONTEND_API_BASE_URL=
CRM_FRONTEND_API_TIMEOUT=30000
CRM_ASSISTANT_TYPEWRITER_INTERVAL=12
CRM_ASSISTANT_TYPEWRITER_STEP=4

# -------------------- 内置 PostgreSQL 容器设置 --------------------
CRM_DB_NAME=crm
CRM_DB_USERNAME=app_user
CRM_DB_PASSWORD=please-change-db-password

# -------------------- 内置 Redis 容器设置 --------------------
CRM_REDIS_PASSWORD=please-change-redis-password

# -------------------- 内置 MinIO 容器设置 --------------------
CRM_MINIO_ACCESS_KEY=minioadmin
CRM_MINIO_SECRET_KEY=please-change-minio-secret

# -------------------- Java 容器启动参数 --------------------
CRM_JAVA_OPTS=-Xms512m -Xmx1024m -Dfile.encoding=UTF-8
CRM_MCP_JAVA_OPTS=

# -------------------- Nacos 配置中心 --------------------
CRM_NACOS_ENABLED=true
CRM_NACOS_SERVER_ADDR=192.168.50.105:8848
CRM_NACOS_NAMESPACE=
CRM_NACOS_GROUP=DEFAULT_GROUP
CRM_NACOS_DATA_ID=crm.yaml
CRM_MCP_NACOS_DATA_ID=crm-mcp.yaml
CRM_NACOS_SHARED_DATA_IDS=
CRM_NACOS_USERNAME=
CRM_NACOS_PASSWORD=
CRM_NACOS_TIMEOUT_MS=5000
CRM_NACOS_FAIL_FAST=true
