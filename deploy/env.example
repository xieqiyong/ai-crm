CRM_VERSION=latest
COMPOSE_PROJECT_NAME=crm
CRM_TIMEZONE=Asia/Shanghai

CRM_FRONTEND_PORT=80
CRM_FRONTEND_API_BASE_URL=
CRM_FRONTEND_API_TIMEOUT=30000

CRM_DB_NAME=crm
CRM_DB_USERNAME=app_user
CRM_DB_PASSWORD=please-change-db-password
CRM_JPA_DDL_AUTO=update

CRM_REDIS_ENABLED=true
CRM_REDIS_PASSWORD=please-change-redis-password
CRM_REDIS_DATABASE=1

CRM_JAVA_OPTS=-Xms512m -Xmx1024m -Dfile.encoding=UTF-8
CRM_JWT_SECRET=please-change-this-secret-key-to-at-least-32-bytes
CRM_JWT_TTL_SECONDS=86400
CRM_PASSWORD_RESET_EXPOSE_TOKEN=false
CRM_LOG_LEVEL=INFO

CRM_NACOS_ENABLED=false
CRM_MINIO_ENABLED=false
CRM_ES_ENABLED=false
