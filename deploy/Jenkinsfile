pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  parameters {
    string(name: 'branch', defaultValue: 'main', description: 'Git 分支')
  }

  environment {
    GIT_URL = "http://192.168.50.96:8888/xieqy/crm.git"
    GIT_CREDENTIALS_ID = "liusu"
    PRODUCT_ID = "crm"
    PRODUCT_PATH_BASE = "/app/builds/products"
    JAVA_HOME = "/root/liusu/jdk-21.0.1"
    JDK_VERSION = "21"
    NODE_VERSION = "22.22.2"
    FRONTEND_PORT = "80"
    NVM_DIR = "${HOME}/.nvm"
  }

  stages {
    stage('拉取代码') {
      steps {
        echo "拉取代码分支：${params.branch}"
        checkout([
          $class: 'GitSCM',
          branches: [[name: params.branch]],
          userRemoteConfigs: [[
            url: env.GIT_URL,
            credentialsId: env.GIT_CREDENTIALS_ID
          ]]
        ])
      }
    }

    stage('检查构建环境') {
      steps {
        sh '''
          set -e
          echo "检查基础环境"
          export PATH="$JAVA_HOME/bin:$PATH"
          echo "使用 JDK $JDK_VERSION：$JAVA_HOME"
          java -version
          mvn -version
          docker version
          docker compose version || docker-compose version

          export NVM_DIR="$HOME/.nvm"
          if [ -s "$NVM_DIR/nvm.sh" ]; then
            . "$NVM_DIR/nvm.sh"
            nvm use "$NODE_VERSION"
          fi
          export NODE_ENV=production

          node -v
          npm -v
        '''
      }
    }

    stage('打离线部署包') {
      steps {
        script {
          def safeBranch = params.branch.trim().replaceAll('[^A-Za-z0-9_.-]', '-')
          def version = "${env.PRODUCT_ID}-${safeBranch}-${env.BUILD_NUMBER}"
          def packageFileName = "${env.PRODUCT_ID}-${safeBranch}-release.tar.gz"
          env.CRM_PACKAGE_VERSION = version
          env.CRM_PACKAGE_FILE_NAME = packageFileName

          withEnv([
            "CRM_VERSION=${version}",
            "CRM_PACKAGE_FILE_NAME=${packageFileName}",
            "CRM_FRONTEND_PORT=${env.FRONTEND_PORT}"
          ]) {
            sh '''
              set -e
              export PATH="$JAVA_HOME/bin:$PATH"
              export NVM_DIR="$HOME/.nvm"
              if [ -s "$NVM_DIR/nvm.sh" ]; then
                . "$NVM_DIR/nvm.sh"
                nvm use "$NODE_VERSION"
              fi
              export NODE_ENV=production

              bash deploy/scripts/build-offline-package.sh
            '''
          }
        }
      }
      post {
        always {
          archiveArtifacts artifacts: "deploy/output/${env.CRM_PACKAGE_FILE_NAME},deploy/output/${env.CRM_PACKAGE_FILE_NAME}.sha256", fingerprint: true, allowEmptyArchive: true
        }
      }
    }

    stage('上传构建物') {
      steps {
        sh '''
          set -e
          OUTPUT_DIR="$PRODUCT_PATH_BASE/$PRODUCT_ID"
          echo "创建产品产物目录：$OUTPUT_DIR"
          mkdir -p "$OUTPUT_DIR"
          cp -f "deploy/output/$CRM_PACKAGE_FILE_NAME" "$OUTPUT_DIR/"
          if [ -f "deploy/output/$CRM_PACKAGE_FILE_NAME.sha256" ]; then
            cp -f "deploy/output/$CRM_PACKAGE_FILE_NAME.sha256" "$OUTPUT_DIR/"
          fi
          echo "离线包已上传到：$OUTPUT_DIR"
        '''
      }
    }
  }

  post {
    success {
      echo "构建成功：${env.CRM_PACKAGE_FILE_NAME}，内部版本：${env.CRM_PACKAGE_VERSION}"
    }
    failure {
      echo "构建失败，请检查 Maven、Node、Docker 或网络依赖"
    }
    always {
      echo "构建流程结束"
    }
  }
}
