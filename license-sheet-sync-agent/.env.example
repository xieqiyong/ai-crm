# noVNC访问密码，仅用于Linux容器的临时远程登录入口
VNC_PASSWORD=请替换为强密码

# License内部接口令牌，必须与dc-manager的LICENSE_INTERNAL_TOKEN保持一致
LICENSE_INTERNAL_TOKEN=

# 是否向License平台提交申请，首次基线完成前必须保持false
LICENSE_API_ENABLED=false

# License平台地址；上云后只需修改此地址并重启容器
LICENSE_API_BASE_URL=http://dc-manager:8089

# License内部申请接口路径
LICENSE_API_APPLY_PATH=/internal/license/openocta/applications

# License接口超时时间，单位毫秒
LICENSE_API_TIMEOUT_MS=30000
